# Sao chép file này thành .env rồi điền key thật (.env đã được .gitignore, không bị đẩy lên git)
GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash-lite

# Azure AI Speech (portal.azure.com -> Speech -> Keys and Endpoint). Có cả hai biến thì dùng Azure, không thì dùng Edge-TTS.
AZURE_SPEECH_KEY=your-key-here
AZURE_SPEECH_REGION=southeastasia
